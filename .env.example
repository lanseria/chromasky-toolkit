CDS_API_KEY=""
TILES_HOST_PATH=""

# 并行工作进程数（默认使用一半 CPU 核心）
# 开发环境可设为更高值以顶满性能，如：NUM_WORKERS=16
#NUM_WORKERS=

# --- 地理范围精细控制（可选，单位：十进制度） ---
# 三级结构：展示范围(DISPLAY) -> 计算范围(CALCULATION) -> 下载范围(DOWNLOAD)
# 默认值完整覆盖中国大陆及南海诸岛（含九段线），一般无需修改。

# 展示范围：地图图幅与 XYZ 瓦片的可见范围
#DISPLAY_NORTH=54
#DISPLAY_SOUTH=2
#DISPLAY_WEST=72
#DISPLAY_EAST=136

# 计算范围：火烧云指数实际计算的格点范围。
# 缺省 = 展示范围四周外扩 CALC_MARGIN_DEGREES（抵消平滑边缘收缩）。
# 设置任一 CALC_* 后，该边不再继承展示范围。
#CALC_MARGIN_DEGREES=1
#CALC_NORTH=
#CALC_SOUTH=
#CALC_WEST=
#CALC_EAST=

# 下载数据缓冲区：计算范围向外扩展的度数（云边界距离计算的邻域缓冲）
#DOWNLOAD_BUFFER_DEGREES=15
